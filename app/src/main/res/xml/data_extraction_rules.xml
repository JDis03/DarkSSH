<?xml version="1.0" encoding="utf-8"?>
<!--
  Security: DarkSSH stores SSH private keys (some without passphrase) and pinned host
  keys in its Room database, plus Keystore-encrypted saved passwords. None of it may
  leave the device through cloud backup or device-to-device transfer (Android 12+).
  The Keystore master key is never transferable, so restored encrypted prefs would be
  unreadable anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
